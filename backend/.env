# Copy to backend/.env and fill in. NEVER commit backend/.env.
# ---- Official Valio Aimo Junction 2026 API (key from the Junction platform) ----
# Leave VALIO_API_KEY empty to run in clearly labelled DEMO mode (no live prices/availability).
VALIO_API_BASE_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=junct_tDnQn4VI_nfhELGCOEkY4vbuxm324MmYmILuokYG03Y
VALIO_CUSTOMER_ID=123
VALIO_TIMEOUT_SECONDS=10
VALIO_CACHE_TTL_SECONDS=120
VALIO_MAX_SHORTLIST=15

# ---- Optional LLM for intent extraction (none | anthropic | openai | gemini) ----
# The deterministic parser always works without it.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# ---- App security (change these for anything beyond a local demo) ----
AUTH_SECRET=change-me-to-a-long-random-string
DEMO_PASSWORD=aimo-demo-2026
AGENT_API_KEY=aimo-agent-local-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Storage ----
# Default: SQLite file backend/aimo.db. PostgreSQL example: postgresql+psycopg://user:pass@localhost/aimo
# DATABASE_URL=sqlite:///./aimo.db
AUTO_INGEST=true
